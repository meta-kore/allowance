# Copy this file to .env and fill it in. Never commit .env.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Use the app that belongs to the sandbox BUSINESS account that funds the agent's allowance.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal sandbox emails of the two approved demo merchants (any sandbox accounts that can receive money).
# You can also set these on the dashboard under Rules.
MERCHANT_EMAIL_PAPERTRAIL=
MERCHANT_EMAIL_CLOUDBOX=

# AI provider for the built-in demo agent: anthropic | groq | gemini | openrouter
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: defaults to a sensible model for the provider
AI_MODEL=

# Secret the agent must present to use the wallet. Set a long random value
# (if left empty it falls back to dev-agent-token, which `npm run check` flags).
AGENT_TOKEN=
PORT=3001

# Offline development without PayPal credentials (never use for the demo):
# PAYPAL_MOCK=1
